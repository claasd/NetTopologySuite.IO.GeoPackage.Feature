<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <RepositoryUrl>https://github.com/claasd/NetTopologySuite.IO.GeoPackage.Feature.git</RepositoryUrl>
        <Authors>claasd</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>Extension for NetTopologySuite to read a geoPackage into a list of Features.</Description>
        <TargetFrameworks>net6.0;net7.0;net8.0;net10.0;netstandard2.0;netstandard2.1</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Dapper" Version="2.1.86" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
      <PackageReference Include="NetTopologySuite.IO.GeoPackage" Version="2.0.0" />
      <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
      <PackageReference Include="SQLitePCLRaw.core" Version="3.0.5" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CdIts.NetTopologySuite.IO.GeoPackage.Features\CdIts.NetTopologySuite.IO.GeoPackage.Features.csproj" />
    </ItemGroup>
</Project>
